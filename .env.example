# Contact form (EmailJS) — optional.
# The app ships with a working default config; override here only if you want to
# point the contact form at your own EmailJS service.
# The EmailJS public key is meant to be public, so NEXT_PUBLIC_ is correct.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
